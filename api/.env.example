# ============================================================
# Mi House Spa — API (Node.js) — cấu hình môi trường
# Copy file này thành `.env` rồi chỉnh giá trị cho phù hợp.
# ============================================================

NODE_ENV=development
PORT=4000

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=mihousespa
DB_PREFIX=table_

# --- Auth ---
JWT_SECRET=doi-mat-khau-nay-thanh-mot-chuoi-ngau-nhien-dai
JWT_EXPIRES_IN=7d

# --- Cloudinary ---
# Lấy tại https://console.cloudinary.com/settings/api-keys
# Để trống nếu chưa có → API sẽ chạy ở chế độ LOCAL (ảnh giữ trong DB)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mihouse-spa

# --- CORS (danh sách domain được phép gọi API) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
